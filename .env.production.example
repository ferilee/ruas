# Koneksi database MariaDB di docker-compose
DB_HOST=mariadb
DB_PORT=3306
DB_HOST_PORT=3308
DB_USER=utbk
DB_PASSWORD=ganti-ini-password-mysql
DB_ROOT_PASSWORD=ganti-ini-root-password-mysql
DB_NAME=utbk_belajar

# Password akses aplikasi (kosongkan untuk nonaktif)
APP_PASSWORD=ganti-juga-password-app

# Password editor/admin (kosongkan untuk menonaktifkan editor)
ADMIN_PASSWORD=ganti-password-editor

# CORS origin (kosongkan untuk auto localhost:FRONTEND_PORT)
CORS_ORIGIN=https://domain-anda.com
